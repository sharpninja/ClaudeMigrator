<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClaudeMigrator.App.ViewModels"
             xmlns:wiz="using:ClaudeMigrator.App.ViewModels.Wizards"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="ClaudeMigrator.App.Views.Wizards.WebRecreationWizardView"
             x:DataType="wiz:WebRecreationWizardViewModel">
    <Grid RowDefinitions="Auto,*,Auto" Margin="24">
        <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,16">
            <TextBlock Classes="title" Text="{Binding Title}" />
            <TextBlock Text="{Binding Subtitle}" Opacity="0.8" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding Steps}" Margin="0,12,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:WizardStepViewModel">
                        <Border Padding="10,6" CornerRadius="8" BorderThickness="1"
                                BorderBrush="#2B2F36"
                                Background="{Binding IsCurrent, Converter={x:Static vm:StepHighlightConverter.Instance}}">
                            <TextBlock Text="{Binding Title}" FontSize="12" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Carousel Grid.Row="1" SelectedIndex="{Binding CurrentStepIndex}">
            <!-- 0 Intro -->
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Classes="section" Text="Overview" />
                    <TextBlock TextWrapping="Wrap"
                               Text="Recreate every project, conversation, and project doc from a claude.ai data export ZIP under the new Claude account, using an attached Edge debugging session." />
                    <TextBlock TextWrapping="Wrap"
                               Text="Before continuing, run Start-LiveClaudeEdge.ps1 to open a dedicated debug profile signed into the target account. Confirm http://127.0.0.1:9222 is reachable." />
                </StackPanel>
            </Border>

            <!-- 1 Export ZIP -->
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Classes="section" Text="Export ZIP" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.75"
                               Text="Path to the official Claude data export ZIP (downloaded from claude.ai/settings/data-privacy-controls)." />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Grid.Column="0" Text="{Binding ExportZipPath, Mode=TwoWay}" Watermark="C:\path\to\claude-export.zip" />
                        <Button Grid.Column="1" Content="Browse" Click="BrowseExportZip_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 2 Edge -->
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Classes="section" Text="Edge debug URL" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.75"
                               Text="Remote debugging endpoint of the Edge profile signed into the new Claude account." />
                    <TextBox Text="{Binding EdgeDebugUrl, Mode=TwoWay}" Watermark="http://127.0.0.1:9222" />
                </StackPanel>
            </Border>

            <!-- 3 Output -->
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Classes="section" Text="Output manifest" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.75"
                               Text="Where to write the recreation manifest. Use this file later with --verify-web-recreation to confirm everything landed." />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Grid.Column="0" Text="{Binding OutputManifestPath, Mode=TwoWay}" Watermark="manifest.json" />
                        <Button Grid.Column="1" Content="Browse" Click="BrowseManifest_Click" />
                    </Grid>
                    <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="10">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Transcript project name" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TranscriptProjectName, Mode=TwoWay}" Watermark="(optional)" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Model" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Model, Mode=TwoWay}" Watermark="(optional, e.g. claude-sonnet-4-6)" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 4 Confirm -->
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Classes="section" Text="Confirm" />
                    <StackPanel Spacing="6">
                        <TextBlock Opacity="0.75" FontSize="12" Text="Export ZIP" />
                        <TextBlock Text="{Binding ExportZipPath}" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12" TextWrapping="Wrap" />
                        <TextBlock Opacity="0.75" FontSize="12" Margin="0,8,0,0" Text="Edge debug URL" />
                        <TextBlock Text="{Binding EdgeDebugUrl}" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12" />
                        <TextBlock Opacity="0.75" FontSize="12" Margin="0,8,0,0" Text="Output manifest" />
                        <TextBlock Text="{Binding OutputManifestPath}" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                    <CheckBox Content="Dry run (do not write to Claude)" IsChecked="{Binding DryRun, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <!-- 5 Run -->
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Classes="section" Text="Run" />
                    <TextBlock Text="{Binding ResultMessage}" TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                        <Border Grid.Column="0" Classes="card">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Projects created" Opacity="0.7" FontSize="12" />
                                <TextBlock Text="{Binding CreatedProjectCount}" FontSize="22" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Classes="card">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Conversations" Opacity="0.7" FontSize="12" />
                                <TextBlock Text="{Binding CreatedConversationCount}" FontSize="22" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Classes="card">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Docs" Opacity="0.7" FontSize="12" />
                                <TextBlock Text="{Binding CreatedDocCount}" FontSize="22" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Classes="card">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Failed" Opacity="0.7" FontSize="12" />
                                <TextBlock Text="{Binding FailedOperationCount}" FontSize="22" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Background="#0F1014" BorderBrush="#2B2F36" BorderThickness="1" CornerRadius="8" Padding="8">
                        <ListBox Height="220" ItemsSource="{Binding LogLines}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </StackPanel>
            </Border>
        </Carousel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" Margin="0,16,0,0" HorizontalAlignment="Right">
            <Button Content="Back" Command="{Binding BackCommand}" IsEnabled="{Binding CanGoBack}" />
            <Button Content="Next" Command="{Binding NextCommand}" IsEnabled="{Binding CanGoNext}" />
            <Button Content="Run" Command="{Binding FinishCommand}" IsEnabled="{Binding CanFinish}" />
            <Button Content="Cancel" Command="{Binding CancelCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
