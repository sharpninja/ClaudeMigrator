<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ClaudeMigrator.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="ClaudeMigrator.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1280"
        Height="900"
        MinWidth="960"
        MinHeight="720"
        Icon="/Assets/avalonia-logo.ico"
        Title="ClaudeMigrator">

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Background="#0F1014" BorderBrush="#2B2F36" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Button Grid.Column="0" Content="Home" Command="{Binding NavigateHomeCommand}" IsVisible="{Binding IsOnWizard}" />
                <TextBlock Grid.Column="1" Text="ClaudeMigrator" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding StatusText}" Opacity="0.7" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <ContentControl Grid.Row="1" Content="{Binding CurrentView}" />

        <Border Grid.Row="2" Background="#0F1014" BorderBrush="#2B2F36" BorderThickness="0,1,0,0" Padding="20,6">
            <TextBlock FontSize="11" Opacity="0.55" Text="{Binding DebugLogPath}" TextWrapping="NoWrap" />
        </Border>
    </Grid>
</Window>
