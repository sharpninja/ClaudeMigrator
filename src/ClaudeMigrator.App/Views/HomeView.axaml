<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClaudeMigrator.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="ClaudeMigrator.App.Views.HomeView"
             x:DataType="vm:HomeViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32" Spacing="24" MaxWidth="1280" HorizontalAlignment="Center">
            <StackPanel Spacing="8">
                <TextBlock Classes="title" Text="ClaudeMigrator" />
                <TextBlock Opacity="0.75" TextWrapping="Wrap"
                           Text="Pick the workflow you need. Each one is a focused wizard that asks only for the inputs it requires." />
                <TextBlock FontSize="12" Opacity="0.55" Text="{Binding DebugLogPath}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Open Logs Folder" Command="{Binding OpenLogsCommand}" />
                    <Button Content="Open Sessions Folder" Command="{Binding OpenSessionsCommand}" />
                </StackPanel>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Workflows}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:WorkflowCardViewModel">
                        <Button Margin="0,0,16,16"
                                Padding="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding $parent[ItemsControl].((vm:HomeViewModel)DataContext).SelectWorkflowCommand}"
                                CommandParameter="{Binding WorkflowId}">
                            <Border Background="#17181C" BorderBrush="#2B2F36" BorderThickness="1" CornerRadius="16" Padding="20">
                                <Grid ColumnDefinitions="6,*" ColumnSpacing="16">
                                    <Border Grid.Column="0" Background="{Binding Accent}" CornerRadius="3" />
                                    <StackPanel Grid.Column="1" Spacing="8">
                                        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Subtitle}" Opacity="0.85" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Description}" Opacity="0.6" TextWrapping="Wrap" FontSize="12" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
